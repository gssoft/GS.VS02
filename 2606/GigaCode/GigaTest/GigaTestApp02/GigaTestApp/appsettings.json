{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "ReverseProxy": {
    "Routes": {
      "weather-route": {
        "RouteId": "weather-route",
        "ClusterId": "weather-cluster",
        "Match": {
          "Path": "/proxy/weather"
        }
      },
      "employees-route": {
        "RouteId": "employees-route",
        "ClusterId": "employees-cluster",
        "Match": {
          "Path": "/proxy/employees"
        }
      },
      "employees-by-id-route": {
        "RouteId": "employees-by-id-route",
        "ClusterId": "employees-cluster",
        "Match": {
          "Path": "/proxy/employees/{*path}"
        }
      }
    },
    
    "Clusters": {
      "weather-cluster": {
        "ClusterId": "weather-cluster",
        "Destinations": {
          "destination1": {
            "Url": "http://localhost:5281"
          }
        }
      },
      "employees-cluster": {
        "ClusterId": "employees-cluster",
        "Destinations": {
          "destination1": {
            "Url": "http://localhost:5281"
          }
        }
      }
    }
  }
}
