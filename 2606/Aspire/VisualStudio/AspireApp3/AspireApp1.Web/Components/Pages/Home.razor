@page "/"
@using AspireApp1.Web
@inject WeatherApiClient WeatherApiClient
@rendermode InteractiveServer

<PageTitle>Прогноз погоды — Aspire Demo</PageTitle>

<div class="container mt-4">
    <h1 class="mb-4">🌤️ Прогноз погоды</h1>

    <p class="text-muted">
        Данные получены из <code>ApiService</code> через Aspire Service Discovery
        (работает в Docker Desktop).
    </p>

    @if (_isLoading)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2"></span>
            Загрузка данных из ApiService...
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">
            <strong>Ошибка:</strong> @_error
        </div>
    }
    else if (_forecasts is null || _forecasts.Length == 0)
    {
        <div class="alert alert-warning">Данные о погоде не получены.</div>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Дата</th>
                    <th>Темп. (°C)</th>
                    <th>Темп. (°F)</th>
                    <th>Описание</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forecast in _forecasts)
                {
                    <tr>
                        <td>@forecast.Date.ToString("dd.MM.yyyy")</td>
                        <td>@forecast.TemperatureC°C</td>
                        <td>@forecast.TemperatureF°F</td>
                        <td>
                            <span class="badge @GetBadgeColor(forecast.TemperatureC)">
                                @forecast.Summary
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button class="btn btn-primary" @onclick="RefreshAsync">
            🔄 Обновить данные
        </button>
    }
</div>

@code {
    private WeatherForecast[]? _forecasts;
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadWeatherAsync();
    }

    private async Task LoadWeatherAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _forecasts = await WeatherApiClient.GetWeatherAsync(maxItems: 10);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshAsync()
    {
        await LoadWeatherAsync();
    }

    private string GetBadgeColor(int tempC) => tempC switch
    {
        < 0 => "bg-primary",
        < 10 => "bg-info",
        < 20 => "bg-success",
        < 30 => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
