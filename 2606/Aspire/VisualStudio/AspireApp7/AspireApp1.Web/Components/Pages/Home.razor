@page "/"
@using AspireApp1.Web
@inject WeatherApiClient WeatherApiClient
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Прогноз погоды — Aspire Demo</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            🌤️ Прогноз погоды
            @if (_autoRefresh)
            {
                <span class="badge bg-success ms-2 fs-6" style="animation: pulse 1.5s infinite">
                    <span class="me-1">●</span>LIVE
                </span>
            }
        </h1>
    </div>

    <p class="text-muted">
        Данные получены из <code>ApiService</code> через Aspire Service Discovery
        (работает в Docker Desktop).
    </p>

    <!-- Панель управления автообновлением -->
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="autoRefreshSwitch"
                       @bind="_autoRefresh" @bind:after="OnAutoRefreshChanged">
                <label class="form-check-label" for="autoRefreshSwitch">
                    Автообновление
                </label>
            </div>

            <div class="d-flex align-items-center gap-2">
                <label for="intervalSelect" class="form-label mb-0">Период:</label>
                <select id="intervalSelect" class="form-select form-select-sm" style="width: auto"
                        @bind="_intervalSeconds" @bind:after="OnIntervalChanged">
                    <option value="3">3 секунды</option>
                    <option value="5">5 секунд</option>
                    <option value="10">10 секунд</option>
                    <option value="30">30 секунд</option>
                    <option value="60">1 минута</option>
                </select>
            </div>

            @if (_lastUpdate != default)
            {
                <small class="text-muted">
                    🕐 Обновлено: @_lastUpdate.ToString("HH:mm:ss")
                </small>
            }

            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="ManualRefreshAsync">
                🔄 Обновить сейчас
            </button>
        </div>
    </div>

    <!-- Состояния -->
    @if (_isLoading && _forecasts is null)
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2"></span>
            Первичная загрузка данных из ApiService...
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">
            <strong>Ошибка:</strong> @_error
            @if (_autoRefresh)
            {
                <small class="d-block mt-1">
                    Автообновление продолжит попытки через @_intervalSeconds сек.
                </small>
            }
        </div>
    }

    <!-- Таблица прогнозов -->
    @if (_forecasts is { Length: > 0 })
    {
        <div class="position-relative">
            @if (_isRefreshing)
            {
                <div class="position-absolute top-0 end-0 m-2">
                    <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                </div>
            }

            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Дата</th>
                        <th>Темп. (°C)</th>
                        <th>Темп. (°F)</th>
                        <th>Описание</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var forecast in _forecasts)
                    {
                        <tr>
                            <td>@forecast.Date.ToString("dd.MM.yyyy")</td>
                            <td>@forecast.TemperatureC°C</td>
                            <td>@forecast.TemperatureF°F</td>
                            <td>
                                <span class="badge @GetBadgeColor(forecast.TemperatureC)">
                                    @forecast.Summary
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!_isLoading)
    {
        <div class="alert alert-warning">Данные о погоде не получены.</div>
    }
</div>

<style>
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }
</style>

@code {
    private WeatherForecast[]? _forecasts;
    private bool _isLoading = true;
    private bool _isRefreshing;
    private string? _error;
    private DateTime _lastUpdate;

    // Настройки автообновления
    private bool _autoRefresh = true;
    private int _intervalSeconds = 5;

    // Управление жизненным циклом таймера
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        // Первичная загрузка
        await LoadWeatherAsync(isInitial: true);

        // Запускаем цикл автообновления
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        // Останавливаем предыдущий таймер, если был
        StopAutoRefresh();

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(_intervalSeconds));
        var token = _cts.Token;

        // Запускаем фоновый цикл (fire-and-forget)
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timer.WaitForNextTickAsync(token))
                {
                    if (!_autoRefresh) continue;

                    await LoadWeatherAsync(isInitial: false);

                    // ВАЖНО: обновляем UI через InvokeAsync,
                    // т.к. мы находимся не в UI-потоке Blazor
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException)
            {
                // Нормальное завершение при остановке — ничего не делаем
            }
            catch (Exception ex)
            {
                // Логируем, но не даём циклу упасть
                Console.WriteLine($"[AutoRefresh] Ошибка: {ex.Message}");
            }
        }, token);
    }

    private void StopAutoRefresh()
    {
        _cts?.Cancel();
        _timer?.Dispose();
        _cts?.Dispose();
        _timer = null;
        _cts = null;
    }

    private async Task LoadWeatherAsync(bool isInitial)
    {
        if (isInitial)
        {
            _isLoading = true;
        }
        else
        {
            _isRefreshing = true;
        }

        _error = null;

        try
        {
            _forecasts = await WeatherApiClient.GetWeatherAsync(maxItems: 10);
            _lastUpdate = DateTime.Now;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private async Task ManualRefreshAsync()
    {
        await LoadWeatherAsync(isInitial: false);
    }

    private void OnAutoRefreshChanged()
    {
        if (_autoRefresh && _timer is null)
        {
            StartAutoRefresh();
        }
    }

    private void OnIntervalChanged()
    {
        // При смене интервала — перезапускаем таймер
        if (_autoRefresh)
        {
            StartAutoRefresh();
        }
    }

    private string GetBadgeColor(int tempC) => tempC switch
    {
        < 0 => "bg-primary",
        < 10 => "bg-info",
        < 20 => "bg-success",
        < 30 => "bg-warning text-dark",
        _ => "bg-danger"
    };

    // ВАЖНО: освобождаем ресурсы при уходе со страницы
    public ValueTask DisposeAsync()
    {
        StopAutoRefresh();
        return ValueTask.CompletedTask;
    }
}

