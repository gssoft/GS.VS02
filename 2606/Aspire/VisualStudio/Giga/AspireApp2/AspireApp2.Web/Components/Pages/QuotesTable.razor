@page "/"
@using System.Collections.Concurrent
@using AspireApp1.Web.Services
@using Quotes.Shared.Contracts

@* Меняем клиент на наш сервис котировок *@
@inject IQuotesClient QuotesClient 
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Портфель Finance — Котировки</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            📈 Портфель: Finance
            @if (_autoRefresh)
            {
                <span class="badge bg-success ms-2 fs-6" style="animation: pulse 1.5s infinite">
                    <span class="me-1">●</span>LIVE
                </span>
            }
        </h1>
    </div>

    <p class="text-muted">
        Данные получены из <code>ApiService</code> через внутренний канал в реальном времени.
    </p>

    <!-- Панель управления -->
    <div class="card mb-4">
        <div class="card-body d-flex align-items-center gap-3 flex-wrap">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="autoRefreshSwitch"
                       @bind="_autoRefresh" @bind:after="OnAutoRefreshChanged">
                <label class="form-check-label" for="autoRefreshSwitch">
                    Автообновление (Stream)
                </label>
            </div>

            <div class="d-flex align-items-center gap-2">
                <label for="intervalSelect" class="form-label mb-0">Интервал опроса:</label>
                <select id="intervalSelect" class="form-select form-select-sm" style="width: auto"
                        @bind="_intervalSeconds" @bind:after="OnIntervalChanged">
                    <option value="1">1 секунда</option>
                    <option value="3">3 секунды</option>
                    <option value="5">5 секунд</option>
                    <option value="10">10 секунд</option>
                </select>
            </div>

            @if (_lastUpdate != default)
            {
                <small class="text-muted">
                    🕐 Последняя сделка: @_lastUpdate.ToString("HH:mm:ss")
                </small>
            }

            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="ManualClear">
                🗑️ Очистить таблицу
            </button>
        </div>
    </div>

    <!-- Состояния подключения -->
    @if (_isConnecting && !_quotes.Any())
    {
        <div class="alert alert-info">
            <span class="spinner-border spinner-border-sm me-2"></span>
            Подключение к потоку котировок ApiService...
        </div>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger">
            <strong>Ошибка потока данных:</strong> @_error
            @if (_autoRefresh)
            {
                <small class="d-block mt-1">
                    Попытка переподключения через @_intervalSeconds сек.
                </small>
            }
        </div>
    }

    <!-- Таблица котировок -->
    @if (_quotes.Any())
    {
        <div class="position-relative">
            @if (_isRefreshing)
            {
                <div class="position-absolute top-0 end-0 m-2">
                    <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                </div>
            }

            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark sticky-top" style="top: 0; z-index: 10;">
                    <tr>
                        <th>Тикер</th>
                        <th class="text-end">Цена (₽)</th>
                        <th class="text-end">Объем</th>
                        <th>Время (МСК)</th>
                        <th>Направление</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quote in _quotes.Reverse()) // Свежие сверху
                    {
                        var priceChangeClass = GetPriceBadgeClass(quote);
                        
                        <tr>
                            <td><strong>@quote.Ticker</strong></td>
                            <td class="text-end fw-bold @priceChangeClass">
                                @quote.Last.ToString("F2")
                            </td>
                            <td class="text-end text-muted">@quote.Volume.ToString("N0")</td>
                            <td>@(quote.TimestampUtc.AddHours(3).ToString("HH:mm:ss"))</td>
                            <td>
                                <span class="badge @(GetTrendBadge(quote))">
                                    @GetTrendSymbol(quote)
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!_isConnecting)
    {
        <div class="alert alert-warning">Нет входящих котировок.</div>
    }
</div>

<style>
    @@keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.6; }
    }
    
    /* Для фиксации шапки таблицы при скролле */
    .sticky-top {
        position: sticky;
        top: 0;
    }
</style>

@code {
    private readonly ConcurrentQueue<QuoteDto> _quotes = new();
    private bool _isConnecting = true;
    private bool _isRefreshing;
    private string? _error;
    private DateTime _lastUpdate;

    // Настройки UI
    private bool _autoRefresh = true;
    private int _intervalSeconds = 3; // Используется только как задержка при переподключении

    // Управление стримом
    private CancellationTokenSource? _cts;
    private Task? _streamTask;

    protected override async Task OnInitializedAsync()
    {
        await ConnectToStreamAsync();
    }

    private async Task ConnectToStreamAsync()
    {
        StopStream();

        _cts = new CancellationTokenSource();
        _isConnecting = true;
        StateHasChanged();

        try
        {
            _streamTask = Task.Run(async () =>
            {
                try
                {
                    await foreach (var quote in QuotesClient.StreamQuotesAsync(_cts.Token))
                    {
                        EnqueueQuote(quote);

                        while (_quotes.Count > 100)
                        {
                            _quotes.TryDequeue(out _);
                        }

                        InvokeAsync(StateHasChanged);
                    }
                }
                catch (OperationCanceledException) { /* Нормально */ }
                catch (Exception ex)
                {
                    _error = $"Поток разорван: {ex.Message}";
                    InvokeAsync(StateHasChanged);

                    if (_autoRefresh)
                    {
                        await Task.Delay(TimeSpan.FromSeconds(_intervalSeconds));
                        if (_autoRefresh) await ConnectToStreamAsync();
                    }
                }
            }, _cts.Token);
        }
        catch
        {
            _isConnecting = false;
            throw;
        }
    }

    private void EnqueueQuote(QuoteDto quote)
    {
        _quotes.Enqueue(quote);
        _lastUpdate = DateTime.Now;
        _error = null;
    }

    private void ManualClear()
    {
        while (_quotes.TryDequeue(out _)) { }
        _lastUpdate = default;
        StateHasChanged();
    }

    private void OnAutoRefreshChanged()
    {
        if (_autoRefresh)
        {
            _ = ConnectToStreamAsync();
        }
        else
        {
            StopStream();
        }
    }

    private void OnIntervalChanged()
    {
        if (_autoRefresh)
        {
            _ = ConnectToStreamAsync();
        }
    }

    private void StopStream()
    {
        _cts?.Cancel();
    }

    // === Визуальная логика отображения ===

    private string GetPriceBadgeClass(QuoteDto q) => "text-success";
    private string GetTrendBadge(QuoteDto q) => "bg-light text-dark";
    private string GetTrendSymbol(QuoteDto q) => "↔";

    public async ValueTask DisposeAsync()
    {
        StopStream();

        if (_streamTask != null)
        {
            var timeout = Task.Delay(1500);
            var completed = await Task.WhenAny(_streamTask, timeout);
            try { await _streamTask; } catch (OperationCanceledException) { }
        }

        _cts?.Dispose();

        _cts = null;
        _streamTask = null;
    }
}

