@page "/trading"
@rendermode InteractiveServer

@inject TradingApiClient Api

<h3>Трейдинг</h3>

<div class="row">
    <div class="col-md-6">
        <h4>Рыночные данные</h4>
        <button class="btn btn-primary" @onclick="LoadMarketData">Загрузить AAPL</button>
        @if (marketData is not null)
        {
            <p>@marketData.Symbol: @marketData.Price.ToString("C")</p>
        }
    </div>
    <div class="col-md-6">
        <h4>Ордера</h4>
        <button class="btn btn-success" @onclick="PlaceOrder">Купить AAPL x10</button>
        <ul>
            @foreach (var order in orders)
            {
                <li>@order.Side @order.Quantity @order.Symbol @@ @order.Price</li>
            }
        </ul>
    </div>
</div>

@code {
    private MarketData? marketData;
    private List<Order> orders = new();

    protected override async Task OnInitializedAsync()
    {
        orders = await Api.GetOrdersAsync();
    }

    // private async Task LoadMarketData()
    // {
    //     marketData = await Api.GetMarketDataAsync("AAPL");
    // }

    private async Task LoadMarketData()
    {
        Console.WriteLine("[Trading] LoadMarketData вызван");
        marketData = await Api.GetMarketDataAsync("AAPL");
        Console.WriteLine($"[Trading] Получено: {marketData?.Symbol} {marketData?.Price}");
        StateHasChanged();
    }

    private async Task PlaceOrder()
    {
        var md = await Api.GetMarketDataAsync("AAPL");
        if (md is null) return;

        await Api.PlaceOrderAsync(new Order
        {
            Symbol = "AAPL",
            Price = md.Price,
            Quantity = 10,
            Side = "Buy"
        });

        orders = await Api.GetOrdersAsync();
    }
}
